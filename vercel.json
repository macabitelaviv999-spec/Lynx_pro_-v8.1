{
  "redirects": [
    {
      "source": "/app",
      "destination": "/app/",
      "permanent": true
    },
    {
      "source": "/r/:id",
      "destination": "/app/?r=:id",
      "permanent": false
    },
    {
      "source": "/t/:code",
      "destination": "/app/?t=:code",
      "permanent": false
    },
    {
      "source": "/i/:biz",
      "destination": "/app/?i=:biz",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/app/",
      "destination": "/app.html"
    },
    {
      "source": "/app/index.html",
      "destination": "/app.html"
    },
    {
      "source": "/app/manifest.json",
      "destination": "/app-manifest.json"
    },
    {
      "source": "/app/preview.jpg",
      "destination": "/app-preview.jpg"
    },
    {
      "source": "/app/icon-180.png",
      "destination": "/app-icon-180.png"
    },
    {
      "source": "/app/icon-192.png",
      "destination": "/app-icon-192.png"
    },
    {
      "source": "/app/icon-512.png",
      "destination": "/app-icon-512.png"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self)"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/app.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/app/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
